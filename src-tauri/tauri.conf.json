{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelFlow",
  "version": "0.1.0",
  "identifier": "com.tunnelflow.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TunnelFlow",
        "width": 370,
        "height": 670,
        "minWidth": 370,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "focus": true,
        "label": "main"
      },
      {
        "label": "tray",
        "title": "TunnelFlow Tray",
        "url": "/?view=tray",
        "width": 260,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}